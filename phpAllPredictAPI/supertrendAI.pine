//@version=5
indicator("Supertrend with Signals", overlay=true, timeframe="", timeframe_gaps=true)

// Input parameters
atrPeriod = input.int(10, "ATR Length", minval=1)
factor = input.float(3.0, "Factor", minval=0.01, step=0.01)

// Calculate Supertrend
[supertrend, direction] = ta.supertrend(factor, atrPeriod)

// Detect trend change
directionChanged = ta.change(direction)
buySignal = directionChanged < 0
sellSignal = directionChanged > 0

// Plot Supertrend lines
upTrend = plot(direction < 0 ? supertrend : na, "Up Trend", color=color.green, style=plot.style_linebr, linewidth=2)
downTrend = plot(direction > 0 ? supertrend : na, "Down Trend", color=color.red, style=plot.style_linebr, linewidth=2)

// Plot body middle for fill
bodyMiddle = plot((open + close) / 2, display=display.none)
fill(bodyMiddle, upTrend, color.new(color.green, 90), fillgaps=false)
fill(bodyMiddle, downTrend, color.new(color.red, 90), fillgaps=false)

// Plot Buy/Sell signals
plotshape(buySignal, title="Buy Signal", location=location.belowbar, color=color.new(color.green, 0), style=shape.labelup, text="Buy", textcolor=color.white, size=size.small)
plotshape(sellSignal, title="Sell Signal", location=location.abovebar, color=color.new(color.red, 0), style=shape.labeldown, text="Sell", textcolor=color.white, size=size.small)

// Alert conditions
alertcondition(buySignal, title="Supertrend Buy", message="Supertrend: Buy Signal!")
alertcondition(sellSignal, title="Supertrend Sell", message="Supertrend: Sell Signal!")