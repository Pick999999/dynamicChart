#T=trade
 // ส่งคำสั่งซื้อ Multipliers
        ws.send(JSON.stringify({
            "buy": 1,
            "parameters": {
                "symbol": "frxEURUSD", // สัญลักษณ์ EUR/USD
                "amount": 10, // จำนวนเงินลงทุน
                "multiplier": 200, // ค่า leverage หรือ multiplier
                "stop_loss": 5, // ระบุ stop loss
                "take_profit": 10, // ระบุ take profit
                "currency": "USD" // สกุลเงินที่ใช้เทรด
            }
}));
// หรือ แบบอื่นๆ 
 ws.send(JSON.stringify({
                "buy": 1,
                "price": 10, // ราคาที่จะลงทุน
                "parameters": {
                    "contract_type": "CALL", // ประเภทของสัญญา
                    "symbol": "frxEURUSD", // สัญลักษณ์การเทรด (EUR/USD)
                    "duration": 5, // ระยะเวลา
                    "duration_unit": "m", // หน่วยเวลา (m = นาที, h = ชั่วโมง)
                    "currency": "USD"
                }
 }));
 /*
 ประเภทของ contract_type:
นี่คือรายการประเภท contract_type ที่สามารถใช้ได้:

CALL: สัญญาที่คาดว่าราคาจะเพิ่มขึ้น (ซื้อขึ้น)
PUT: สัญญาที่คาดว่าราคาจะลดลง (ขายลง)
DIGITOVER: สัญญาที่คาดว่าหมายเลขสุดท้ายของราคาจะมากกว่าค่าที่ระบุ
DIGITUNDER: สัญญาที่คาดว่าหมายเลขสุดท้ายของราคาจะน้อยกว่าค่าที่ระบุ
DIGITMATCH: สัญญาที่คาดว่าหมายเลขสุดท้ายของราคาจะตรงกับค่าที่ระบุ
DIGITDIFF: สัญญาที่คาดว่าหมายเลขสุดท้ายของราคาจะไม่ตรงกับค่าที่ระบุ
ASIANU: สัญญาที่คาดว่าราคาเฉลี่ยจะเพิ่มขึ้น (สำหรับตลาดเอเชีย)
ASIAND: สัญญาที่คาดว่าราคาเฉลี่ยจะลดลง (สำหรับตลาดเอเชีย)
EXPIRYRANGE: สัญญาที่คาดว่าราคาสุดท้ายจะอยู่ในช่วงที่กำหนด
EXPIRYMISS: สัญญาที่คาดว่าราคาสุดท้ายจะอยู่นอกช่วงที่กำหนด
RANGE: สัญญาที่คาดว่าราคาจะเคลื่อนไหวในช่วงที่กำหนด
UPORDOWN: สัญญาที่คาดว่าราคาจะเคลื่อนที่สูงกว่าหรือต่ำกว่าระดับที่กำหนด
ONETOUCH: สัญญาที่คาดว่าราคาจะสัมผัสระดับที่กำหนดครั้งเดียว
NOTOUCH: สัญญาที่คาดว่าราคาจะไม่สัมผัสระดับที่กำหนด
 */
#T=createws
let chart, candleSeries, ema3Series, ema5Series, emaLongSeries;
let ws = null;
let tooltipEnabled = true;
let realTimeEnabled = false;
let selectedCandle = null;
let candleData = [];
		
let ema3Data = [], ema5Data = [];
let ema3Values = [], ema5Values = []; emaLongValues = [];
let markersLoss = [] ;
let labResult = null ;
let conflictData =  null; 
let mixedData = null ;
const ws = new WebSocket('wss://ws.binaryws.com/websockets/v3?app_id=YOUR_APP_ID');

ws.onopen = () => {
    // Authorize ด้วย API Token
    ws.send(JSON.stringify({
        "authorize": "YOUR_API_TOKEN"
    }));
};

ws.onmessage = (event) => {
    const data = JSON.parse(event.data);

    if (data.time) {
        updateServerTime(data.time);
    }

    if (data.msg_type === 'authorize') {
        console.log('Authorized successfully.');

        // ดึงรายการสถานะที่เปิดอยู่ (Active Multipliers Contracts)
        ws.send(JSON.stringify({
            "portfolio": 1
        }));
    }
    if (data.msg_type === 'candles') {
        
    }
    
    // ตอบกลับ proposal โดยเข้า Buy  ได้จาก PlaceTradeProposal
    if (data.proposal) {
       // ตัวอย่าง: proposal.proposal.id หรือ data.proposal.id (ขึ้นกับ response)
       const proposalId = data.proposal.proposal?.id || data.proposal.id;
       const askPrice = data.proposal.proposal?.ask_price || data.proposal.ask_price;       
       PlaceBuyOrder(proposalId) ;
     }

     // จัดการผลลัพธ์การซื้อ / เปิด Order ที่ขอเปิดไปแล้ว   (มี contract_id)
     if (data.buy) {
         console.log("Bought contract:", data.buy.contract_id);
	 document.getElementById("ContractList").innerHTML = data.buy.contract_id;
	 // ทำการ TrackOrder โดย ร้องขอ data.proposal_open_contract
	 thisContractID = data.buy.contract_id ;
	 getTrackOrder(thisContractID) ;
     }
     
     // รายการ Order ที่ถูก Track ไปแล้ว 
     if (data.proposal_open_contract) {
        alert('Yes')  ;
        const contractList = data.proposal_open_contract;                  
	entry_tick = contractList.entry_tick ;
	
     } 

     // เกิดเมื่อส่งคำสั่งขาย Sale ไป  และรอ สถานะ การขายได้ 
     if (data.msg_type === 'sell') {
        // ผลลัพธ์จากคำสั่งปิดสถานะ
        console.log('Sell response:', data);
     } else {
        console.log('Received message:', data);
     }
			}



    // รายการเทรดที่เปิดอยู่ 
    if (data.msg_type === 'portfolio') {
        console.log('Active contracts:', data);

        if (data.portfolio && data.portfolio.contracts.length > 0) {
            // ปิดสถานะ Multipliers Order ตัวแรก
            const contractId = data.portfolio.contracts[0].contract_id; // เลือก contract_id ตัวแรก
            console.log('Closing contract with ID:', contractId);

            ws.send(JSON.stringify({
                "sell": contractId,
                "price": 0 // ปิดสถานะที่ราคาตลาดปัจจุบัน
            }));
        } else {
            console.log('No active contracts to close.');
        }
     } 
     

ws.onerror = (error) => {
    console.error('WebSocket Error:', error);
};


function subscribeToTime() {
   if (timeSubscription) {
      clearInterval(timeSubscription);
   }

   websocket.send(JSON.stringify({
      "time": 1
   }));
   timeSubscription = setInterval(() => {
      if (websocket && websocket.readyState === WebSocket.OPEN) {
         websocket.send(JSON.stringify({
            "time": 1
         }));
      }
   }, 1000);
}
function updateServerTime(timestamp) {

   const date = new Date(timestamp * 1000);
   const timeStr = date.toLocaleTimeString();
   document.getElementById('serverTime').textContent = timeStr;

   if (date.getSeconds() === 0) {
      fetchCandles();
   }
}

// ร้องขอ Proposal ก่อนทำการ Buy
function PlaceTradeProposal(action) {

			 amount = 30 ;
			 contractType = action ;	
			 tradeGranuSelected0 = document.getElementById("tradeGranu").value ;
			 tradeGranuSelected = tradeGranuSelected0.split('-');

             console.log('tradeGranuSelected',tradeGranuSelected) ;
			
                
			 duration = tradeGranuSelected[0] ;
			 durationUnit = tradeGranuSelected[1] ;

			 //symbol = document.getElementById("assetSelect").value ;
             symbol = document.getElementById("SymBols").value ;
			 amount = document.getElementById("moneyTrade").value  ;
			 

			 const proposalReq = {
             buy: 1,
             price: parseFloat(amount),
             parameters: {
               amount: parseFloat(amount),
               basis: "stake",
               contract_type: contractType,
               currency: "USD",
               duration: parseInt(duration),
               duration_unit: durationUnit,
               symbol: symbol
             }
            };
            ws.send(JSON.stringify(proposalReq));
         
		
} // end func

// เข้า Buy ซื้อทันทีที่ได้ proposal->data.buy
function PlaceBuyOrder(proposalId)  {

       if (proposalId) {
          ws.send(JSON.stringify({ buy: proposalId }));
       }
}

function getTrackOrder(thisContractID) {

         ws.send(JSON.stringify( { 
	   proposal_open_contract: 1, 
	   contract_id: thisContractID, 
         }));
		
} // end func

