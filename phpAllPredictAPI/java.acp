#T=ajaxthen
// ตัวอย่างที่ 1: ใช้ Fetch API แบบต่อเนื่อง
fetch('https://api.example.com/user')
  .then(response => response.json())
  .then(userData => {
    console.log('ข้อมูลผู้ใช้:', userData);
    // เรียก API ที่สองโดยใช้ข้อมูลจาก API แรก
    return fetch(`https://api.example.com/orders/${userData.id}`);
  })
  .then(response => response.json())
  .then(orderData => {
    console.log('ข้อมูลการสั่งซื้อ:', orderData);
  })
  .catch(error => {
    console.error('เกิดข้อผิดพลาด:', error);
  });

// ตัวอย่างที่ 2: สร้างฟังก์ชันแยกเพื่อความชัดเจน
function getUser() {
  return fetch('https://api.example.com/user')
    .then(response => response.json());
}

function getOrders(userId) {
  return fetch(`https://api.example.com/orders/${userId}`)
    .then(response => response.json());
}

// เรียกใช้งานฟังก์ชันแบบต่อเนื่อง
getUser()
  .then(user => {
    console.log('ข้อมูลผู้ใช้:', user);
    return getOrders(user.id);
  })
  .then(orders => {
    console.log('ข้อมูลการสั่งซื้อ:', orders);
  })
  .catch(error => {
    console.error('เกิดข้อผิดพลาด:', error);
  });

// ตัวอย่างที่ 3: การส่ง POST request แบบต่อเนื่อง
function createUser(userData) {
  return fetch('https://api.example.com/users', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json'
    },
    body: JSON.stringify(userData)
  })
  .then(response => response.json());
}

function createOrder(userId, orderData) {
  return fetch('https://api.example.com/orders', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({ ...orderData, userId })
  })
  .then(response => response.json());
}

// เรียกใช้งาน POST requests แบบต่อเนื่อง
const newUser = {
  name: 'John Doe',
  email: 'john@example.com'
};

const newOrder = {
  items: ['item1', 'item2'],
  total: 100
};

createUser(newUser)
  .then(user => {
    console.log('สร้างผู้ใช้สำเร็จ:', user);
    return createOrder(user.id, newOrder);
  })
  .then(order => {
    console.log('สร้างออเดอร์สำเร็จ:', order);
  })
  .catch(error => {
    console.error('เกิดข้อผิดพลาด:', error);
  });

#T=fetch
// ฟังก์ชันสำหรับเรียก API ด้วย Fetch
async function callAPI(url, options = {}) {
    // กำหนดค่า default options
    const defaultOptions = {
        method: 'GET',
        headers: {
            'Content-Type': 'application/json',
            // เพิ่ม token สำหรับ authentication (ถ้ามี)
            'Authorization': 'Bearer ' + localStorage.getItem('token')
        },
        // เพิ่ม credentials ถ้าต้องการส่ง cookies
        credentials: 'include'
    };

    // รวม options ที่ส่งมากับ default options
    const fetchOptions = {
        ...defaultOptions,
        ...options,
        headers: {
            ...defaultOptions.headers,
            ...options.headers
        }
    };

    try {
        // เริ่มเรียก API
        console.log(`กำลังเรียก API: ${url}`);
        const response = await fetch(url, fetchOptions);

        // ตรวจสอบ HTTP status
        if (!response.ok) {
            // ถ้า status ไม่ใช่ 2xx จะจัดการ error ตาม status code
            switch (response.status) {
                case 400:
                    throw new Error('ข้อมูลไม่ถูกต้อง');
                case 401:
                    throw new Error('ไม่ได้รับอนุญาต กรุณาเข้าสู่ระบบใหม่');
                case 403:
                    throw new Error('ไม่มีสิทธิ์เข้าถึง');
                case 404:
                    throw new Error('ไม่พบข้อมูลที่ต้องการ');
                case 500:
                    throw new Error('เซิร์ฟเวอร์ผิดพลาด');
                default:
                    throw new Error(`เกิดข้อผิดพลาด: ${response.status}`);
            }
        }

        // แปลงข้อมูลเป็น JSON
        const data = await response.json();
        return data;

    } catch (error) {
        // จัดการ error ที่เกิดขึ้น
        console.error('เกิดข้อผิดพลาด:', error);
        
        // ตรวจสอบว่าเป็น network error หรือไม่
        if (!navigator.onLine) {
            throw new Error('ไม่มีการเชื่อมต่ออินเทอร์เน็ต');
        }
        
        // ส่งต่อ error ไปให้ส่วนที่เรียกใช้จัดการต่อ
        throw error;
    }.
}

// ตัวอย่างการใช้งาน GET
try {
    const data = await callAPI('https://api.example.com/users');
    console.log('ข้อมูลที่ได้:', data);
} catch (error) {
    // แสดง error ให้ผู้ใช้เห็น
    alert(error.message);
}

// ตัวอย่างการใช้งาน POST
try {
    const newUser = {
        name: 'John Doe',
        email: 'john@example.com'
    };
    
    const data = await callAPI('https://api.example.com/users', {
        method: 'POST',
        body: JSON.stringify(newUser)
    });
    console.log('สร้างผู้ใช้สำเร็จ:', data);
} catch (error) {
    alert(error.message);
}

// ตัวอย่างการใช้งาน PUT
try {
    const updatedUser = {
        name: 'John Updated',
        email: 'john.updated@example.com'
    };
    
    const data = await callAPI('https://api.example.com/users/1', {
        method: 'PUT',
        body: JSON.stringify(updatedUser)
    });
    console.log('อัพเดทผู้ใช้สำเร็จ:', data);
} catch (error) {
    alert(error.message);
}

// ตัวอย่างการใช้งาน DELETE
try {
    await callAPI('https://api.example.com/users/1', {
        method: 'DELETE'
    });
    console.log('ลบผู้ใช้สำเร็จ');
} catch (error) {
    alert(error.message);
}

